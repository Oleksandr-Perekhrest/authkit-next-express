{
  "name": "@authkit/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "prisma generate --no-hints && tsdown",
    "start": "node --env-file-if-exists=.env dist/index.mjs",
    "typecheck": "prisma generate --no-hints && tsc --noEmit",
    "db:generate": "prisma generate --no-hints",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsdown": "^0.23.2",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@authkit/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "arctic": "3.7.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "zod": "catalog:"
  }
}
