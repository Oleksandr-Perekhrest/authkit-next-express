@host = http://localhost:4000

### Health
GET {{host}}/health

### Register
POST {{host}}/auth/register
Content-Type: application/json

{
  "email": "demo@example.com",
  "password": "password123",
  "name": "Demo"
}

### Register: email taken (409)
POST {{host}}/auth/register
Content-Type: application/json

{
  "email": "demo@example.com",
  "password": "password123"
}

### Register: invalid data (400)
POST {{host}}/auth/register
Content-Type: application/json

{
  "email": "not-an-email",
  "password": "123"
}

### Login
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "demo@example.com",
  "password": "password123"
}

> {%
    const cookies = response.headers.valuesOf("Set-Cookie");
    const raw = cookies.find(c => c.startsWith("refresh_token="));
    if (raw) {
        client.global.set("oldRefreshToken", raw.split(";")[0].split("=")[1]);
    }
%}

### Login: wrong password (401)
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "demo@example.com",
  "password": "wrong-password"
}

### Me
GET {{host}}/auth/me

### Me: no cookies (401)
# @no-cookie-jar
GET {{host}}/auth/me

### Refresh
POST {{host}}/auth/refresh

### Refresh: no cookies (401)
# @no-cookie-jar
POST {{host}}/auth/refresh

### Refresh: reuse old token (401, revokes family)
# @no-cookie-jar
POST {{host}}/auth/refresh
Cookie: refresh_token={{oldRefreshToken}}
