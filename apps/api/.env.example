PORT=4000
# Number of trusted proxy hops (0 = no proxy trust; set to match your infra depth)
TRUST_PROXY=0
DATABASE_URL="postgresql://authkit:authkit@localhost:5432/authkit"
CORS_ORIGIN=http://localhost:3000
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
