NODE_ENV=production
PORT=4000
# Number of trusted proxy hops (0 = no proxy, for direct local use)
TRUST_PROXY=0
# Points to the local docker-compose Postgres via host.docker.internal
DATABASE_URL=postgresql://authkit:authkit@host.docker.internal:5432/authkit
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
# Copy GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET from apps/api/.env
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
