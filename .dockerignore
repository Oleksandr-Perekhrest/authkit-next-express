# VCS
.git
.gitignore

# Dependencies — reinstalled inside Docker
node_modules
**/node_modules

# Build artifacts — regenerated inside Docker
**/dist
apps/api/src/generated

# Web app — only package.json is COPY'd for pnpm workspace dep resolution; everything else is excluded
apps/web/*
!apps/web/package.json

# API test files — not needed for building or running the API image
apps/api/http

# Secrets — must never be baked into the image
.env
.env.*
**/.env
**/.env.*

# Editor and OS
.vscode
.idea
.DS_Store
Thumbs.db
**/*.log
